{
  "name": "terminal-dev",
  "description": "Terminal développeur : esthétique code, mono vert/bleu, cartes écran, sons click.",
  "subtitles": {
    "font": "Bangers",
    "highlight": "#3BA7FF",
    "emphasis": "#7CF2B6",
    "max_words": 3
  },
  "motion": {
    "accent": "#3BA7FF"
  },
  "sfx": {
