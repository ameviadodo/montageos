      "punch": "click",
      "pulse": "glitch",
      "ease": null
    }
  },
  "library": {
    "etat": "Draft",
    "palette": [
      "#FFFFFF",
      "#3BA7FF",
      "#0B0F1A"
    ],
    "fonts": {
      "display": "Luckiest Guy",
      "body": "Inter",
      "mono": "JetBrains Mono"
    },
    "cards": [
      "ecran.push3d",
      "ecran.rail",
      "titre.barre"
    ]
  }
}