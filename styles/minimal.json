{
  "name": "minimal",
  "description": "Sobre, documentaire / corporate : peu de zooms, sous-titres discrets en phrase.",
  "cut": {"min_silence": 0.7, "padding": 0.15, "remove_fillers": true},
  "zoom": {"every_s": 12, "scale": 1.06, "pattern": ["ease"]},
  "subtitles": {"font": "Poppins SemiBold", "size": 0.045, "uppercase": false, "max_words": 8, "max_chars": 42, "highlight": "#FFFFFF", "emphasis": "#FFFFFF", "pop": false, "karaoke": false, "outline_w": 0.003, "shadow": 2, "margin_v": 0.08},
  "broll": {"per_minute": 2, "duration": 3.5},
  "sfx": {"enabled": false},
  "motion": {"hook_title": false}
}
