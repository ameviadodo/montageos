# Toutes facultatives — MonteurOS fonctionne sans (Wikimedia, voix Edge, bruitages synthétisés).
# Le plus simple : bin/monteur cles --set CLE=valeur   puis   bin/monteur cles --test
ELEVENLABS_API_KEY=    # https://elevenlabs.io/app/settings/api-keys  (voix off, mots horodatés)
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # bin/monteur voix --liste-voix --moteur elevenlabs
# ELEVENLABS_MODEL=eleven_multilingual_v2
INWORLD_API_KEY=       # https://platform.inworld.ai  (clé « Basic » du portail, ou id:secret)
# INWORLD_VOICE=       # sinon la première voix française du compte
# INWORLD_MODEL=inworld-tts-1.5-max
WIKIMEDIA_ACCESS_TOKEN=  # facultatif : Wikimedia Commons marche sans
PEXELS_API_KEY=        # https://www.pexels.com/api/  (B-roll vidéo/photo gratuits)
PIXABAY_API_KEY=       # https://pixabay.com/api/docs/
FREESOUND_API_KEY=     # https://freesound.org/apiv2/apply
MAGNIFIC_API_KEY=      # upscale Magnific
# MAGNIFIC_API_BASE=https://api.freepik.com
# MAGNIFIC_API_HEADER=x-freepik-api-key
GEMINI_API_KEY=        # Veo (moteur de Google Flow)
# VEO_MODEL=veo-3.1-generate-preview
